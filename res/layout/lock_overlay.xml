<?xml version="1.0" encoding="utf-8"?>
<!--
  电视锁屏。手机锁屏的构图（居中单列、圆点在上键盘在下）搬到 16:9 的电视上：
  四周留给背景，中间一块玻璃面板保证 3 米外的可读性。

  改这个文件时守住两条：
  1. 所有 id 必须保留（LockOverlay 直接按 id 取控件）。
  2. 键盘必须保持 3x4 且按键可聚焦 —— 遥控器是唯一的输入设备，没有触摸兜底。
-->
<com.toy.tvlock.LockRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lock">

    <!--
      统一压暗层。背景可能是插画也可能只是渐变，亮度差别很大；这一层保证无论抽到哪张，
      白字都有对比度。不处理触摸/焦点，纯视觉。
    -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_lock"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="52dp"
        android:paddingTop="22dp"
        android:paddingRight="52dp"
        android:paddingBottom="18dp">

        <!-- 主文案：家里的话，写在最上面 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14"
            android:text="爸爸爱你们"
            android:textColor="@color/text_hero"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.08"
            android:text="不能偷看电视哟"
            android:textColor="@color/text_sub"
            android:textSize="20sp" />

        <!-- 状态行：解锁 / 设置 / 修改密码，由代码写入 -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.12"
            android:text="请输入 4 位密码"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <!-- 密码位 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot0"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/dot_off" />

            <View
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/dot_off" />

            <View
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/dot_off" />

            <View
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/dot_off" />
        </LinearLayout>

        <!-- 提示 / 错误 / 倒计时 -->
        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="22dp"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn1"
                    style="@style/KeyBtn"
                    android:text="1" />

                <Button
                    android:id="@+id/btn2"
                    style="@style/KeyBtn"
                    android:text="2" />

                <Button
                    android:id="@+id/btn3"
                    style="@style/KeyBtn"
                    android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn4"
                    style="@style/KeyBtn"
                    android:text="4" />

                <Button
                    android:id="@+id/btn5"
                    style="@style/KeyBtn"
                    android:text="5" />

                <Button
                    android:id="@+id/btn6"
                    style="@style/KeyBtn"
                    android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn7"
                    style="@style/KeyBtn"
                    android:text="7" />

                <Button
                    android:id="@+id/btn8"
                    style="@style/KeyBtn"
                    android:text="8" />

                <Button
                    android:id="@+id/btn9"
                    style="@style/KeyBtn"
                    android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClear"
                    style="@style/KeyBtnFunc"
                    android:text="清空" />

                <Button
                    android:id="@+id/btn0"
                    style="@style/KeyBtn"
                    android:text="0" />

                <Button
                    android:id="@+id/btnDel"
                    style="@style/KeyBtnFunc"
                    android:text="删除" />
            </LinearLayout>
        </LinearLayout>

        <!-- 落款 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.26"
            android:text="萌萌达"
            android:textColor="@color/text_signature"
            android:textSize="13sp" />
    </LinearLayout>
</com.toy.tvlock.LockRootLayout>
